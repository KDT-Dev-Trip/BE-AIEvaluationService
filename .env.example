# AI Evaluation Service Environment Configuration Example
# 이 파일을 복사해서 .env로 이름을 바꾸고 실제 값을 입력하세요

# ==============================================
# Database Configuration (MySQL)
# ==============================================
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_DATABASE=ai_evaluation_dev_db
MYSQL_USERNAME=ai_eval_dev
MYSQL_PASSWORD=dev_password

# Production MySQL Configuration
MYSQL_PROD_HOST=your-prod-mysql-host
MYSQL_PROD_PORT=3306
MYSQL_PROD_DATABASE=ai_evaluation_prod_db
MYSQL_PROD_USERNAME=ai_eval_prod
MYSQL_PROD_PASSWORD=your-production-password

# ==============================================
# AI API Configuration
# ==============================================
GEMINI_API_KEY=your-gemini-api-key-here

# ==============================================
# AWS Configuration
# ==============================================
AWS_ACCESS_KEY=your-aws-access-key
AWS_SECRET_KEY=your-aws-secret-key
AWS_REGION=ap-northeast-2

# ==============================================
# Kafka Configuration
# ==============================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9093

# Production Kafka
KAFKA_PROD_BOOTSTRAP_SERVERS=your-prod-kafka:9092

# ==============================================
# Redis Configuration (Optional)
# ==============================================
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=

# ==============================================
# Application Configuration
# ==============================================
SPRING_PROFILES_ACTIVE=dev,mysql

# Logging Level
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_DEVTRIP=DEBUG

# ==============================================
# Monitoring Configuration
# ==============================================
ZIPKIN_BASE_URL=http://localhost:9411
PROMETHEUS_METRICS_ENABLED=true

# ==============================================
# Security Configuration
# ==============================================
JWT_SECRET=your-jwt-secret-key-here
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8084

# ==============================================
# Development Settings
# ==============================================
DEBUG_MODE=true
MOCK_EXTERNAL_APIS=false